---
/**
 * Card de advogado. Sem foto → placeholder com iniciais sobre mármore.
 * Com foto: P&B → cor no hover/foco (padrão de retrato: fundo liso, luz quente).
 */
interface Props {
  nome: string;
  oab: string;
  cargo?: string;
  foto?: string;
}

const { nome, oab, cargo, foto } = Astro.props;
const iniciais = nome
  .split(" ")
  .filter((parte) => parte.length > 2)
  .map((parte) => parte[0])
  .slice(0, 2)
  .join("");
---

<article class="lc" data-reveal tabindex={foto ? 0 : undefined}>
  <div class="lc__photo bg-marmore">
    {foto ? <img src={foto} alt={`Retrato de ${nome}`} loading="lazy" /> : <span aria-hidden="true">{iniciais}</span>}
  </div>
  <div class="lc__body">
    <h3 class="lc__name">{nome}</h3>
    {cargo && <p class="muted small">{cargo}</p>}
    <p class="overline">{oab}</p>
  </div>
</article>

<style>
  .lc { display: grid; gap: var(--space-4); }
  .lc__photo {
    display: grid; place-items: center;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    color: var(--prata-300);
    font-family: var(--font-display); font-size: var(--text-h2); letter-spacing: var(--tracking-overline);
  }
  .lc__photo img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1);
    transition: filter var(--dur-base) var(--ease-padrao);
  }
  .lc:hover img, .lc:focus-visible img { filter: none; }
  .lc__body { display: grid; gap: var(--space-1); }
  .lc__name { font-size: var(--text-h3); }
</style>
