---
/** Aviso contra o golpe do falso advogado (padrão Ingrácio/Koetz). */
import Icon from "./Icon.astro";
import { site } from "../../data/site";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<aside class:list={["asn", { "asn--compact": compact }]} aria-labelledby="asn-title">
  <Icon name="shield" size={compact ? 24 : 32} class="asn__icon" />
  <div class="asn__body">
    <p id="asn-title" class="asn__title">Como saber se a mensagem é mesmo do escritório</p>
    <p class="asn__text">
      O escritório {site.nome} <strong>nunca pede pagamento por Pix ou depósito para "liberar" benefício</strong>.
      Na dúvida, fale com a gente pelo nosso número oficial antes de pagar qualquer valor.
    </p>
  </div>
</aside>

<style>
  .asn {
    display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: start;
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .asn--compact { padding: var(--space-4); }
  .asn__icon { color: var(--color-accent); }
  .asn__body { display: grid; gap: var(--space-2); }
  .asn__title { font-family: var(--font-display); font-weight: 600; }
  .asn--compact .asn__text { font-size: var(--text-small); }
</style>
